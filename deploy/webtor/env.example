# Copy to .env and edit. Never commit the real .env.

# Domain only — no https:// and no trailing slash.
WEBTOR_DOMAIN=webtor.example.com

# Admin password for the Webtor UI. Use a long random value.
WEBTOR_ADMIN_PASSWORD=replace-with-a-long-random-password

# Disk housekeeping thresholds (percentages or byte values like 10G).
CLEANER_KEEP_FREE=25%
CLEANER_FREE=35%

# Optional extras (uncomment in docker-compose.yml to use):
# OSDB_API_KEY=            # OpenSubtitles lookups
# TMDB_API_KEY=            # richer metadata
# OMDB_API_KEY=
# WAIT_FOR_VPN=true        # when running behind Gluetun
